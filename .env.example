# LLM (server only, never NEXT_PUBLIC_*)
ANTHROPIC_API_KEY=
# claude (Haiku 5.5, needs the key above) or simulated (fixed rules, no key: end-to-end tests and demos)
NEXO_AGENT_MODEL=claude

# Conversations DB (web + agent). Local file or Turso URL
CONVERSATIONS_DB_URL=file:conversations.db
CONVERSATIONS_DB_AUTH_TOKEN=

# Tickets DB (ticket-service). Local file or Turso URL
TICKETS_DB_URL=file:tickets.db
TICKETS_DB_AUTH_TOKEN=

# web -> ticket-service
TICKET_SERVICE_URL=http://localhost:3001
TICKET_SERVICE_SECRET=dev-service-secret

# ticket-service admin routes (outage, reseed)
ADMIN_KEY=dev-admin-key

# Simulated outages of the ticket-service (0 in tests)
OUTAGE_RATE=0

# Messages that may call the model per São Paulo day. Over them the chat says the demo is unavailable. At about
# US$ 0.001 per reply, the global ceiling keeps a bad day near US$ 1.
USAGE_LIMIT_PER_IP_PER_DAY=300
USAGE_LIMIT_GLOBAL_PER_DAY=1000

# Signs the session cookie
SESSION_SECRET=dev-session-secret-change-me
