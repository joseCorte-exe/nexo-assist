{
  "name": "nexo-assist",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm -r db:migrate",
    "db:seed": "pnpm -r db:seed",
    "test:e2e": "pnpm --filter @nexo/web test:e2e"
  }
}
